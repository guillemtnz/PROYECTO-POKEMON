<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="640.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.CrianzaController">
   <children>

      <!-- Fondo -->
      <ImageView fitHeight="400.0" fitWidth="640.0" pickOnBounds="true" preserveRatio="false">
         <image><Image url="@../../Media/Background/fondoEquipo.png" /></image>
      </ImageView>

      <!-- Título -->
      <AnchorPane layoutX="0.0" layoutY="0.0" prefHeight="50.0" prefWidth="640.0" style="-fx-background-color: rgba(0,0,0,0.7);">
         <Label layoutX="20.0" layoutY="12.0" text="CRIANZA DE POKÉMON" textFill="white">
            <font><Font name="System Bold" size="14.0" /></font>
         </Label>
      </AnchorPane>

      <!-- ===== PANEL PADRE (MACHO) ===== -->
      <AnchorPane layoutX="30.0" layoutY="70.0" prefHeight="200.0" prefWidth="260.0" style="-fx-background-color: rgba(0,100,200,0.6); -fx-background-radius: 10; -fx-border-color: white; -fx-border-radius: 10; -fx-border-width: 2;">

         <Label layoutX="10.0" layoutY="8.0" text="♂  PADRE" textFill="white">
            <font><Font name="System Bold" size="14.0" /></font>
         </Label>

         <!-- Imagen padre -->
         <ImageView fx:id="imgPadre" fitHeight="100.0" fitWidth="100.0" layoutX="80.0" layoutY="30.0" pickOnBounds="true" preserveRatio="true" />

         <!-- Selector padre -->
         <ComboBox fx:id="cbPadre" layoutX="15.0" layoutY="140.0" onAction="#onSeleccionarPadre" prefWidth="230.0" style="-fx-background-color: rgba(255,255,255,0.9); -fx-font-size: 11px;" />

         <!-- Info padre -->
         <Label fx:id="lblInfoPadre" layoutX="15.0" layoutY="170.0" textFill="white" wrapText="true">
            <font>
               <Font name="System Bold" size="12.0" />
            </font>
         </Label>
      </AnchorPane>

      <!-- ===== PANEL MADRE (HEMBRA) ===== -->
      <AnchorPane layoutX="350.0" layoutY="70.0" prefHeight="200.0" prefWidth="260.0" style="-fx-background-color: rgba(200,60,120,0.6); -fx-background-radius: 10; -fx-border-color: white; -fx-border-radius: 10; -fx-border-width: 2;">

         <Label layoutX="10.0" layoutY="8.0" text="♀  MADRE" textFill="white">
            <font><Font name="System Bold" size="14.0" /></font>
         </Label>

         <!-- Imagen madre -->
         <ImageView fx:id="imgMadre" fitHeight="100.0" fitWidth="100.0" layoutX="80.0" layoutY="30.0" pickOnBounds="true" preserveRatio="true" />

         <!-- Selector madre -->
         <ComboBox fx:id="cbMadre" layoutX="15.0" layoutY="140.0" onAction="#onSeleccionarMadre" prefWidth="230.0" style="-fx-background-color: rgba(255,255,255,0.9); -fx-font-size: 11px;" />

         <!-- Info madre -->
         <Label fx:id="lblInfoMadre" layoutX="15.0" layoutY="170.0" textFill="white" wrapText="true">
            <font>
               <Font name="System Bold" size="12.0" />
            </font>
         </Label>
      </AnchorPane>

      <!-- Símbolo corazón entre paneles -->
      <Label layoutX="302.0" layoutY="140.0" style="-fx-font-size: 32px;" text="♥" textFill="#FF6090" />

      <!-- ===== BOTÓN CRIAR ===== -->
      <Button fx:id="btnCriar" layoutX="220.0" layoutY="290.0" mnemonicParsing="false" onAction="#handleCriar" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: rgba(50,180,80,0.85); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11px; -fx-background-radius: 8; -fx-border-color: white; -fx-border-radius: 8; -fx-border-width: 1;" text="INICIAR CRIANZA">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Button>

         <!-- ===== PANEL HUEVO / RESULTADO ===== -->
      <AnchorPane fx:id="panelHuevo" layoutX="140.0" layoutY="60.0" prefHeight="260.0" prefWidth="360.0" style="-fx-background-color: rgba(0,0,0,0.85); -fx-background-radius: 12; -fx-border-color: #FFD700; -fx-border-radius: 12; -fx-border-width: 2;" visible="false">

            <Label layoutX="130.0" layoutY="14.0" text="¡UN HUEVO!" textFill="#FFD700">
            <font>
               <Font size="18.0" />
            </font>
         </Label>

            <!-- Imagen huevo / pokemon hijo -->
         <ImageView fx:id="imgHuevoOHijo" fitHeight="120.0" fitWidth="120.0" layoutX="120.0" layoutY="65.0" pickOnBounds="true" preserveRatio="true" />

            <!-- Nombre/mote del hijo (oculto hasta abrir) -->
         <Label fx:id="lblNombreHijo" layoutX="20.0" layoutY="160.0" prefWidth="320.0" textFill="white" wrapText="true">
            <font>
               <Font name="System Bold" size="14.0" />
            </font>
         </Label>

            <!-- Stats del hijo (ocultas hasta abrir) -->
         <Label fx:id="lblStatsHijo" layoutX="20.0" layoutY="185.0" prefWidth="320.0" textFill="#90EE90" visible="false" wrapText="true">
            <font>
               <Font name="System Bold" size="14.0" />
            </font>
         </Label>

            <!-- Botón abrir huevo -->
         <Button fx:id="btnAbrirHuevo" layoutX="90.0" layoutY="215.0" mnemonicParsing="false" onAction="#handleAbrirHuevo" prefHeight="35.0" prefWidth="180.0" style="-fx-background-color: #FFD700; -fx-text-fill: black; -fx-font-weight: bold; -fx-font-size: 10px; -fx-background-radius: 7;" text="ABRIR HUEVO">
            <font>
               <Font name="System Bold" size="14.0" />
            </font>
         </Button>
      </AnchorPane>

      <!-- Mensaje de error / estado -->
      <AnchorPane layoutX="0.0" layoutY="350.0" prefHeight="50.0" prefWidth="640.0" style="-fx-background-color: rgba(0,0,0,0.65);">
         <Label fx:id="lblMensaje" layoutX="20.0" layoutY="12.0" prefWidth="600.0" textFill="white" wrapText="true">
            <font><Font size="14.0" /></font>
         </Label>
         <Button layoutX="516.0" layoutY="11.0" mnemonicParsing="false" onAction="#handleVolver" prefHeight="30.0" prefWidth="106.0" style="-fx-background-color: rgba(255,255,255,0.25); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-background-radius: 5;" text="Volver" />
      </AnchorPane>

   </children>
</AnchorPane>
