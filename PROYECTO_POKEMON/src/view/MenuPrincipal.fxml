      <Button layoutX="55.0" layoutY="192.0" mnemonicParsing="false" onAction="#handleCapturar" prefWidth="130.0" style="-fx-background-color: rgba(0,0,0,0.5); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11px; -fx-background-radius: 5; -fx-alignment: center;" text="CAPTURAR" />

