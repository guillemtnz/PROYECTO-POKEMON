      <Button layoutX="65.0" layoutY="75.0" onAction="#handleCapturar" prefHeight="110.0" prefWidth="110.0" style="-fx-background-color: rgba(255,255,255,0.4); -fx-border-color: white; -fx-border-width: 3; -fx-border-radius: 55; -fx-background-radius: 55;" />
      <ImageView fitHeight="60.0" fitWidth="60.0" layoutX="90.0" layoutY="100.0" mouseTransparent="true" pickOnBounds="true" preserveRatio="true">
