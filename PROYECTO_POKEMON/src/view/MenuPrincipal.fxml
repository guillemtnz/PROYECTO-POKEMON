<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="400.0" prefWidth="640.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.MenuPrincipalController">
   <children>
      <!-- Imagen de fondo -->
      <ImageView fitHeight="400.0" fitWidth="640.0" pickOnBounds="true" preserveRatio="false">
         <image>
            <Image url="@../../Media/Background/ciudadMenu.jpg" />
         </image>
      </ImageView>

      <!-- Botones -->
      <Button fx:id="btnCapturar" layoutX="220.0" layoutY="120.0" mnemonicParsing="false"
              prefHeight="40.0" prefWidth="200.0" text="Capturar Pokémon"
              onAction="#handleCapturar"
              style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;">
         <font><Font name="Press Start 2P" size="8.0" /></font>
      </Button>

      <Button fx:id="btnEquipo" layoutX="220.0" layoutY="175.0" mnemonicParsing="false"
              prefHeight="40.0" prefWidth="200.0" text="Mi Equipo"
              onAction="#handleEquipo"
              style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;">
         <font><Font name="Press Start 2P" size="8.0" /></font>
      </Button>

      <Button fx:id="btnCrianza" layoutX="220.0" layoutY="230.0" mnemonicParsing="false"
              prefHeight="40.0" prefWidth="200.0" text="Crianza"
              onAction="#handleCrianza"
              style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;">
         <font><Font name="Press Start 2P" size="8.0" /></font>
      </Button>

      <Button fx:id="btnCasino" layoutX="220.0" layoutY="285.0" mnemonicParsing="false"
              prefHeight="40.0" prefWidth="200.0" text="Casino"
              onAction="#handleCasino"
              style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;">
         <font><Font name="Press Start 2P" size="8.0" /></font>
      </Button>

      <!-- Cerrar Sesión -->
      <Button fx:id="btnCerrarSesion" layoutX="240.0" layoutY="345.0" mnemonicParsing="false"
              prefHeight="30.0" prefWidth="160.0" text="Cerrar Sesión"
              onAction="#handleCerrarSesion"
              style="-fx-background-color: #444444; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;">
         <font><Font name="Press Start 2P" size="7.0" /></font>
      </Button>
   </children>
</AnchorPane>