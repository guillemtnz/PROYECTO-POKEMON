<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="rootPane" alignment="CENTER" spacing="30.0" prefHeight="400.0" prefWidth="640.0" 
      style="-fx-background-color: #1a1a1a;" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="controller.SeleccionCombateController">
   <children>
      <Label text="ELIJA SU DESAFÍO" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 24;"/>
      <Button text="COMBATE ALEATORIO" onAction="#handleCombateNormal" prefWidth="250.0" 
              style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;"/>
      <Button text="LIGA POKÉMON" onAction="#handleLigaPokemon" prefWidth="250.0" 
              style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;"/>
      <Button text="VOLVER" onAction="#handleVolver" style="-fx-background-color: transparent; -fx-text-fill: #aaa;"/>
   </children>
</VBox>