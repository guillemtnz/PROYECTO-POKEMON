<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="400.0" prefWidth="640.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.CapturaController">
   <children>

      <!-- Imagen de fondo -->
      <ImageView fitHeight="400.0" fitWidth="640.0" pickOnBounds="true" preserveRatio="false">
         <image><Image url="@../../Media/Background/fondoCaptura.png"/></image>
      </ImageView>

      <!-- Barra de vida del Pokemon salvaje -->
      <AnchorPane layoutX="20.0" layoutY="20.0" prefHeight="60.0" prefWidth="250.0"
                  style="-fx-background-color: rgba(0,0,0,0.6); -fx-background-radius: 10;">
         <Label fx:id="lblNombreSalvaje" layoutX="10.0" layoutY="8.0"
                text="TORCHIC  Nv.5" textFill="white">
            <font><Font name="Press Start 2P" size="9.0"/></font>
         </Label>
         <!-- Barra de vida -->
         <AnchorPane layoutX="10.0" layoutY="30.0" prefHeight="12.0" prefWidth="220.0"
                     style="-fx-background-color: #333; -fx-background-radius: 5;">
            <AnchorPane fx:id="barraVida" prefHeight="12.0" prefWidth="180.0"
                        style="-fx-background-color: #44dd44; -fx-background-radius: 5;"/>
         </AnchorPane>
      </AnchorPane>

      <!-- Imagen del Pokemon salvaje -->
      <ImageView fx:id="imgPokemonSalvaje" fitHeight="150.0" fitWidth="150.0"
                 layoutX="400.0" layoutY="60.0" pickOnBounds="true" preserveRatio="true">
         <image><Image url="@../../Media/Front/torchic.png"/></image>
      </ImageView>

      <!-- Barra de vida del jugador -->
      <AnchorPane layoutX="370.0" layoutY="290.0" prefHeight="60.0" prefWidth="250.0"
                  style="-fx-background-color: rgba(0,0,0,0.6); -fx-background-radius: 10;">
         <Label layoutX="10.0" layoutY="8.0" text="ENTRENADOR" textFill="white">
            <font><Font name="Press Start 2P" size="9.0"/></font>
         </Label>
         <Label fx:id="lblPokedollars" layoutX="10.0" layoutY="30.0"
                text="💰 500 PD" textFill="#FFD700">
            <font><Font name="Press Start 2P" size="8.0"/></font>
         </Label>
      </AnchorPane>

      <!-- Caja de acciones -->
      <AnchorPane layoutX="0.0" layoutY="320.0" prefHeight="80.0" prefWidth="350.0"
                  style="-fx-background-color: rgba(0,0,0,0.7); -fx-background-radius: 10;">

         <!-- Botón Pokéball -->
         <Button fx:id="btnPokeball" layoutX="20.0" layoutY="15.0"
                 mnemonicParsing="false" prefHeight="50.0" prefWidth="140.0"
                 text="⚪ Lanzar Pokéball" onAction="#handleLanzarPokeball"
                 style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-font-size: 10px;"/>

         <!-- Botón Huir -->
         <Button fx:id="btnHuir" layoutX="180.0" layoutY="15.0"
                 mnemonicParsing="false" prefHeight="50.0" prefWidth="140.0"
                 text="🏃 Huir" onAction="#handleHuir"
                 style="-fx-background-color: #444444; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-font-size: 10px;"/>
      </AnchorPane>

      <!-- Mensaje de estado -->
      <Label fx:id="lblMensaje" layoutX="0.0" layoutY="290.0" prefWidth="350.0"
             text="¡Un TORCHIC salvaje apareció!" textFill="white"
             style="-fx-background-color: rgba(0,0,0,0.6); -fx-padding: 5; -fx-font-size: 11px; -fx-font-weight: bold;"/>

   </children>
</AnchorPane>